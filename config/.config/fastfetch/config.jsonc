{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "$HOME/.pfp.jpg",
    "width": 23,
    "height": 10,
    "color": {
      "1": "#63c4ff",
      "2": "#63c5f1"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{1}"
    },
    "separator",
    "os",
    "kernel",
    "uptime",
    "shell",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "break"
  ],
  "display": {
    "color": {
      "keys": "#b4c4ff",
      "title": "#bac5f1"
    },
    "percent": {
      "color": {
        "green": "#f6adff",
        "yellow": "#b4c4ff",
        "red": "#ffb4ab"
      }
    }
  }
}
